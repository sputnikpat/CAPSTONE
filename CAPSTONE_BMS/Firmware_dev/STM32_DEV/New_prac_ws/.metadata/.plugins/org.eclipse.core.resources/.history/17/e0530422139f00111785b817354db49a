#include "ina260.h"
extern I2C_HandleTypeDef hi2c1;

uint8_t INA260_Init(void)
{
    uint8_t reg = INA260_REG_MFR_ID;
    uint8_t data[2] = {0};

    if (HAL_I2C_Master_Transmit(&hi2c1, INA260_ADDR, &reg, 1, 20) != HAL_OK)
        return 0;
    if (HAL_I2C_Master_Receive(&hi2c1, INA260_ADDR, data, 2, 20) != HAL_OK)
        return 0;

    uint16_t id = (data[0] << 8) | data[1];
    return (id == 0x5449);   // 1 = INA260 detected correctly
}

float INA260_ReadBusVoltage_V(void)
{
    uint8_t reg = INA260_REG_BUSVOLT;
    uint8_t data[2] = {0};

    if (HAL_I2C_Master_Transmit(&hi2c1, INA260_ADDR, &reg, 1, 20) != HAL_OK)
        return -1.0f;
    if (HAL_I2C_Master_Receive(&hi2c1, INA260_ADDR, data, 2, 20) != HAL_OK)
        return -1.0f;

    uint16_t raw = (data[0] << 8) | data[1];
    return raw * 0.00125f;   // 1.25 mV per LSB
}
