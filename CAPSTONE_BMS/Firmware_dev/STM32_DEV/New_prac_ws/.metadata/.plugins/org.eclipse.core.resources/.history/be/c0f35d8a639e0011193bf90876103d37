void OLED_DrawChar(uint8_t x, uint8_t y, char c)
{
    uint8_t index;

    if (c == ' ')
    {
        index = 0;
    }
    else if (c >= 'A' && c <= 'Z')
    {
        index = 1 + (c - 'A');
    }
    else if (c >= '0' && c <= '9')
    {
        index = 27 + (c - '0');
    }
    else if (c == '.')
    {
        index = 37;
    }
    else if (c == ':')
    {
        index = 38;
    }
    else if (c == '%')
    {
        index = 39;
    }
    else if (c == '-')
    {
        index = 40;
    }
    else
    {
        return;
    }

    for (uint8_t column = 0; column < 5; column++)
    {
        uint8_t column_data = Font5x7[index][column];

        for (uint8_t row = 0; row < 7; row++)
        {
            if (column_data & (1 << row))
            {
                OLED_DrawPixel(x + column, y + row, 1);
            }
        }
    }
}

void OLED_WriteCommand(uint8_t command)
{
    uint8_t data[2];

    data[0] = 0x00;
    data[1] = command;

    HAL_I2C_Master_Transmit(&hi2c1,
                            OLED_ADDRESS << 1,
                            data,
                            2,
                            HAL_MAX_DELAY);
}


void OLED_WriteData(uint8_t data)
{
    uint8_t buffer[2];

    buffer[0] = 0x40;
    buffer[1] = data;

    HAL_I2C_Master_Transmit(&hi2c1,
                            OLED_ADDRESS << 1,
                            buffer,
                            2,
                            HAL_MAX_DELAY);
}

void OLED_Init(void)
{
    HAL_Delay(100);

    OLED_WriteCommand(0xAE);  // Display OFF

    OLED_WriteCommand(0xD5);  // Display clock divide ratio
    OLED_WriteCommand(0x80);

    OLED_WriteCommand(0xA8);  // Multiplex ratio
    OLED_WriteCommand(0x3F);

    OLED_WriteCommand(0xD3);  // Display offset
    OLED_WriteCommand(0x00);

    OLED_WriteCommand(0x40);  // Start line

    OLED_WriteCommand(0x8D);  // Charge pump
    OLED_WriteCommand(0x14);

    OLED_WriteCommand(0x20);  // Memory addressing mode
    OLED_WriteCommand(0x00);

    OLED_WriteCommand(0xA1);  // Segment remap
    OLED_WriteCommand(0xC8);  // COM output scan direction

    OLED_WriteCommand(0xDA);  // COM pins hardware configuration
    OLED_WriteCommand(0x12);

    OLED_WriteCommand(0x81);  // Contrast
    OLED_WriteCommand(0x7F);

    OLED_WriteCommand(0xD9);  // Pre-charge period
    OLED_WriteCommand(0xF1);

    OLED_WriteCommand(0xDB);  // VCOMH deselect level
    OLED_WriteCommand(0x40);

    OLED_WriteCommand(0xA4);  // Display follows RAM

    OLED_WriteCommand(0xA6);  // Normal display

    OLED_WriteCommand(0xAF);  // Display ON

    HAL_Delay(100);
}

void OLED_Fill(uint8_t pattern)
{
    for (uint8_t page = 0; page < 8; page++)
    {
        OLED_WriteCommand(0xB0 + page);

        OLED_WriteCommand(0x02);  // Column low nibble
        OLED_WriteCommand(0x10);  // Column high nibble

        for (uint8_t column = 0; column < 128; column++)
        {
            OLED_WriteData(pattern);
        }
    }
}

void OLED_Clear(void)
{
    for (uint16_t i = 0; i < 1024; i++)
    {
        OLED_Buffer[i] = 0x00;
    }
}

void OLED_DrawPixel(uint8_t x, uint8_t y, uint8_t color)
{
    if (x >= 128 || y >= 64)
        return;

    uint16_t index = x + (y / 8) * 128;
    uint8_t bit = y % 8;

    if (color)
    {
        OLED_Buffer[index] |= (1 << bit);
    }
    else
    {
        OLED_Buffer[index] &= ~(1 << bit);
    }
}

void OLED_Update(void)
{
    for (uint8_t page = 0; page < 8; page++)
    {
        OLED_WriteCommand(0xB0 + page);
        OLED_WriteCommand(0x02);
        OLED_WriteCommand(0x10);

        for (uint8_t column = 0; column < 128; column++)
        {
            OLED_WriteData(OLED_Buffer[page * 128 + column]);
        }
    }
}

void OLED_DrawString(uint8_t x, uint8_t y, const char *str)
{
    while (*str)
    {
        OLED_DrawChar(x, y, *str);

        x += 6;  // 5 pixels character + 1 pixel spacing

        str++;

        if (x >= 123)
        {
            break;
        }
    }
}

void OLED_BootScreen(void)
{
    /* Screen 1 */

    OLED_Clear();

    OLED_DrawString(46, 8, "AUV-01");
    OLED_DrawString(34, 25, "SYSTEM");
    OLED_DrawString(43, 35, "START");

    OLED_Update();

    HAL_Delay(700);


    /* Screen 2 */

    OLED_Clear();

    OLED_DrawString(46, 8, "AUV-01");
    OLED_DrawString(28, 25, "INITIALIZING");

    OLED_Update();

    HAL_Delay(500);


    /* Loading animation */

    for (uint8_t i = 0; i < 10; i++)
    {
        OLED_Clear();

        OLED_DrawString(46, 8, "AUV-01");
        OLED_DrawString(28, 25, "INITIALIZING");

        /* Draw loading bar */

        for (uint8_t x = 0; x < (i + 1) * 10; x++)
        {
            for (uint8_t y = 45; y < 50; y++)
            {
                OLED_DrawPixel(14 + x, y, 1);
            }
        }

        OLED_Update();

        HAL_Delay(150);
    }


    /* System OK */

    OLED_Clear();

    OLED_DrawString(46, 8, "AUV-01");
    OLED_DrawString(40, 25, "SYSTEM");
    OLED_DrawString(43, 35, "OK");

    OLED_Update();

    HAL_Delay(1000);
}

void OLED_Dashboard(void)
{
    char depth_text[32];
    char temp_text[32];

    static int depth = 124;
    static int temperature = 246;
    static int battery = 87;

    /* Convert values */

    snprintf(depth_text, sizeof(depth_text),
             "DEPTH: %d.%dM",
             depth / 10,
             depth % 10);

    snprintf(temp_text, sizeof(temp_text),
             "TEMP: %d.%dC",
             temperature / 10,
             temperature % 10);


    /* Clear screen */

    OLED_Clear();


    /* Header */

    OLED_DrawString(4, 2, "AUV-01");
    OLED_DrawString(82, 2, "ONLINE");


    /* Header separator */

    for (uint8_t x = 0; x < 128; x++)
    {
        OLED_DrawPixel(x, 11, 1);
    }


    /* Depth */

    OLED_DrawString(5, 17, depth_text);


    /* Temperature */

    OLED_DrawString(5, 30, temp_text);


    /* Battery label */

    OLED_DrawString(5, 43, "BAT:");

    /* Battery graphic */

    OLED_DrawBattery(35, 41, battery);


    /* Battery percentage */

    char bat_text[10];

    snprintf(bat_text, sizeof(bat_text),
             "%d%%", battery);

    OLED_DrawString(72, 43, bat_text);


    /* Update */

    OLED_Update();


    /* Simulated sensor changes */

    depth++;

    if (depth > 150)
    {
        depth = 124;
    }


    temperature++;

    if (temperature > 300)
    {
        temperature = 246;
    }


    battery--;

    if (battery < 80)
    {
        battery = 87;
    }
}

void OLED_DrawRect(uint8_t x, uint8_t y, uint8_t width, uint8_t height)
{
    for (uint8_t i = x; i < x + width; i++)
    {
        OLED_DrawPixel(i, y, 1);
        OLED_DrawPixel(i, y + height - 1, 1);
    }

    for (uint8_t i = y; i < y + height; i++)
    {
        OLED_DrawPixel(x, i, 1);
        OLED_DrawPixel(x + width - 1, i, 1);
    }
}

void OLED_DrawBattery(uint8_t x, uint8_t y, uint8_t percent)
{
    /* Battery outline */

    OLED_DrawRect(x, y, 30, 12);

    /* Battery terminal */

    for (uint8_t i = 0; i < 4; i++)
    {
        OLED_DrawPixel(x + 30, y + 4 + i, 1);
    }

    /* Limit percentage */

    if (percent > 100)
    {
        percent = 100;
    }

    /* Calculate fill width */

    uint8_t fill = (percent * 26) / 100;

    /* Fill battery */

    for (uint8_t px = 0; px < fill; px++)
    {
        for (uint8_t py = 0; py < 8; py++)
        {
            OLED_DrawPixel(x + 2 + px, y + 2 + py, 1);
        }
    }
}

